{
  "name": "pds-a2ui-composer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @pds/composer dev",
    "dev:sandbox": "bun run --filter @pds/sandbox dev",
    "build": "bun run --filter '*' build",
    "check:roundtrip": "bun run packages/schema/dev/roundtrip-guard.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write ."
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "@vitejs/plugin-react": "^4.3.3"
  }
}
